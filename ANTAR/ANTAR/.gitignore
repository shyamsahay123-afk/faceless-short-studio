# ANTAR - anything generated, cached or private stays out of the package

# bytecode. a surviving __pycache__ once made two builds run at once.
__pycache__/
*.py[cod]

# the clip cache
vault/clips/
vault/registry.json

# finished work
output/*.mp4
output/scripts/

# logs
logs/*.log

# run state: rotation cursor, render counter, the topic shortlist
config/state/state.json
config/state/topics.json

# keys. the empty template ships, real keys never do.
config/state/keys.json
!config/state/keys.template.json

# secrets and local overrides
.env
.env.*
*.local.json

# editor and system noise
.DS_Store
Thumbs.db
.idea/
.vscode/
